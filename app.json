{
  "expo": {
    "name": "SEMIX Technician",
    "slug": "semix-technician",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/fb311ee4-83cd-412b-9432-227f5210af87"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.semix.technician",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "SEMIX uses your location only while the app is open, to show where you are on your route map.",
        "CFBundleDisplayName": "SEMIX Tech"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-background.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#00685F"
      },
      "package": "com.semix.technician"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#00685F"
        }
      ],
      "./plugins/withIos27Scene",
      [
        "expo-image-picker",
        {
          "photosPermission": "SEMIX adds the photos you choose to the visit, so the office sees the job.",
          "cameraPermission": "SEMIX takes photos of the job for the visit, so the office sees them, and scans a card when the customer pays by card.",
          "microphonePermission": false
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "enableGooglePay": false
        }
      ],
      "expo-notifications"
    ],
    "scheme": "semix-tech",
    "extra": {
      "eas": {
        "projectId": "fb311ee4-83cd-412b-9432-227f5210af87"
      }
    }
  }
}
