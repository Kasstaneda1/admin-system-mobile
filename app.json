{
  "expo": {
    "name": "SEMIX Technician",
    "slug": "semix-technician",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#14B8A6"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.semix.technician"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#14B8A6"
      },
      "package": "com.semix.technician"
    },
    "plugins": [
      "expo-asset",
      "expo-font"
    ]
  }
}
