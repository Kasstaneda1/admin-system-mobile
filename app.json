{
  "expo": {
    "name": "SEMIX Technician",
    "slug": "semix-technician",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.semix.technician"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-background.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#00685F"
      },
      "package": "com.semix.technician"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#00685F"
        }
      ],
      "./plugins/withIos27Scene",
      [
        "expo-image-picker",
        {
          "photosPermission": "SEMIX adds the photos you choose to the visit, so the office sees the job.",
          "cameraPermission": "SEMIX takes photos of the job for the visit, so the office sees them.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
